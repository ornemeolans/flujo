# Puerto HTTP
PORT=3001
# Secreto para firmar los JWT — OBLIGATORIO en producción (ej: `openssl rand -hex 32`)
JWT_SECRET=
# Client ID OAuth de Google (Google Cloud Console → Credenciales → ID de cliente web)
GOOGLE_CLIENT_ID=
# Orígenes permitidos para CORS, separados por coma (vacío = mismo origen / proxy de Vite)
CORS_ORIGINS=
# URL pública de la PWA (los emails enlazan a APP_URL/auth/verify y APP_URL/auth/reset)
APP_URL=http://localhost:5173
# API key de Resend (https://resend.com/api-keys). Vacío = los emails se imprimen en la consola
RESEND_API_KEY=
# Remitente. Sin dominio verificado en Resend usar onboarding@resend.dev (solo envía a tu propio email)
MAIL_FROM=Flujo <onboarding@resend.dev>
# Ruta del archivo SQLite
DB_PATH=./data/flujo.db